diff --git a/libavcodec/aac/aacdec_dsp_template.c b/libavcodec/aac/aacdec_dsp_template.c
--- a/libavcodec/aac/aacdec_dsp_template.c
+++ b/libavcodec/aac/aacdec_dsp_template.c
@@ -33,0 +34,107 @@
+
+#if !USE_FIXED
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Private fixture hook.  The format is documented in
+ * et-audio/capture/aac_capture_format.h in the source checkout that creates
+ * this private build.  Keep this self-contained: this generated source copy
+ * deliberately changes no FFmpeg public headers or normal source files. */
+#define ETAAC_CAPTURE_RECORD_BYTES 12312U
+
+static FILE *etaac_capture_file;
+static const void *etaac_capture_state[64];
+static uint32_t etaac_capture_frame[64];
+static unsigned etaac_capture_disabled;
+
+static void etaac_capture_u32(FILE *f, uint32_t v)
+{
+    const unsigned char b[4] = { v, v >> 8, v >> 16, v >> 24 };
+    if (fwrite(b, 1, sizeof(b), f) != sizeof(b))
+        etaac_capture_disabled = 1;
+}
+
+static void etaac_capture_f32(FILE *f, float v)
+{
+    uint32_t u;
+    memcpy(&u, &v, sizeof(u));
+    etaac_capture_u32(f, u);
+}
+
+static FILE *etaac_capture_open(void)
+{
+    const char *path;
+    static const unsigned char magic[8] = { 'E', 'T', 'A', 'A', 'C', 'C', 'P', '1' };
+
+    if (etaac_capture_file || etaac_capture_disabled)
+        return etaac_capture_file;
+    path = getenv("FF_AAC_CAPTURE");
+    if (!path || !*path || sizeof(float) != 4) {
+        etaac_capture_disabled = 1;
+        return NULL;
+    }
+    etaac_capture_file = fopen(path, "wb");
+    if (!etaac_capture_file) {
+        etaac_capture_disabled = 1;
+        return NULL;
+    }
+    if (fwrite(magic, 1, sizeof(magic), etaac_capture_file) != sizeof(magic))
+        etaac_capture_disabled = 1;
+    etaac_capture_u32(etaac_capture_file, 1);                 /* version */
+    etaac_capture_u32(etaac_capture_file, 32);                /* header bytes */
+    etaac_capture_u32(etaac_capture_file, ETAAC_CAPTURE_RECORD_BYTES);
+    etaac_capture_u32(etaac_capture_file, 1);                 /* IEEE binary32 */
+    etaac_capture_u32(etaac_capture_file, 0x01020304);        /* endian tag */
+    etaac_capture_u32(etaac_capture_file, 0);                 /* flags */
+    if (etaac_capture_disabled) {
+        fclose(etaac_capture_file);
+        etaac_capture_file = NULL;
+    }
+    return etaac_capture_file;
+}
+
+static uint32_t etaac_capture_context(const void *state)
+{
+    unsigned i;
+    for (i = 0; i < FF_ARRAY_ELEMS(etaac_capture_state); i++) {
+        if (etaac_capture_state[i] == state)
+            return i;
+        if (!etaac_capture_state[i]) {
+            etaac_capture_state[i] = state;
+            return i;
+        }
+    }
+    etaac_capture_disabled = 1;
+    return 0;
+}
+
+static void etaac_capture_record(const float *coeff, const float *prior_saved,
+                                 const float *out, const float *next_saved,
+                                 uint32_t context, uint32_t frame,
+                                 uint32_t seq, uint32_t prevseq,
+                                 uint32_t shape, uint32_t prevshape)
+{
+    FILE *f = etaac_capture_open();
+    unsigned i;
+    if (!f || etaac_capture_disabled)
+        return;
+    etaac_capture_u32(f, context + 1);
+    etaac_capture_u32(f, frame);
+    etaac_capture_u32(f, seq);
+    etaac_capture_u32(f, prevseq);
+    etaac_capture_u32(f, shape);
+    etaac_capture_u32(f, prevshape);
+    for (i = 0; i < 1024; i++) etaac_capture_f32(f, coeff[i]);
+    for (i = 0; i <  512; i++) etaac_capture_f32(f, prior_saved[i]);
+    for (i = 0; i < 1024; i++) etaac_capture_f32(f, out[i]);
+    for (i = 0; i <  512; i++) etaac_capture_f32(f, next_saved[i]);
+    if (etaac_capture_disabled) {
+        fclose(etaac_capture_file);
+        etaac_capture_file = NULL;
+    } else {
+        fflush(f);
+    }
+}
+#endif
